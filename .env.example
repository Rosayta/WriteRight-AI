# GEMINI_API_KEY: Optional legacy key for server-side Gemini features.
# Do not expose provider keys in frontend/Vite env variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional server-side key. Enables debounced Claude Haiku live analysis.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
HAIKU_MODEL="claude-haiku-4.5-20251001"

# OPENAI_API_KEY: Optional server-side key. Enables on-demand paraphrasing through the OpenAI Responses API.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_PARAPHRASE_MODEL="gpt-5.1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
